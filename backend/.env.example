# FIXORA backend ortam degiskenleri
# Bu dosyayi kopyalayip ".env" olarak kaydedin ve degerleri doldurun.
# cp .env.example .env

# Gemini API anahtarlari (AI Studio: https://aistudio.google.com/apikey).
# JSON listesi olarak yazilir. Bos / "PASTE_YOUR" ile baslayanlar yok sayilir.
# Uygulama her istekte rastgele bir anahtar secer; 429 donerse digerine gecer.
GEMINI_API_KEYS=["AQ.anahtar1","AQ.anahtar2","AQ.anahtar3","AQ.anahtar4","AQ.anahtar5"]

# Model listesi: secili model once, 429 donerse bu listeden diger modellere gecilir.
GEMINI_MODELS=["gemini-3.5-flash","gemini-3.1-flash-lite"]

# Kotali (anahtar, model) kombinasyonunun dinlenme suresi (saniye).
QUOTA_COOLDOWN_SECONDS=600

# Web demosunun kullanabilecegi eski tek anahtar (istege bagli, geriye uyumluluk).
GOOGLE_API_KEY=

# Kullanicinin tercih ettigi varsayilan dil (de, fr, it, en, tr)
DEFAULT_LANGUAGE=de

# Isvicre FADP uyumu icin girdi dosyalarinin silinme suresi (dakika)
INPUT_RETENTION_MINUTES=15
