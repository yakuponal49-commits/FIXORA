{
  "name": "FIXORA - Analytics Collector",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "trigger",
      "name": "Her Saat",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://host.docker.internal:8000/health",
        "options": {
          "timeout": 10000
        }
      },
      "id": "check-backend",
      "name": "Backend Kontrol",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [470, 300]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst hour = now.getHours();\nconst date = now.toLocaleDateString('tr-TR');\n\n// Simüle edilmiş veri (gerçek backend endpoint'i hazır olana kadar)\nconst data = {\n  status: $input.first().json.status || 'unknown',\n  hour: hour,\n  date: date\n};\n\nreturn [{ json: data }];"
      },
      "id": "prepare-data",
      "name": "Veri Hazırla",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [690, 300]
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "sendMessage",
        "chatId": "={{ $env.TELEGRAM_CHAT_ID }}",
        "text": "📊 FIXORA Saatlik Durum Raporu\n\n📅 Tarih: {{ $json.date }}\n⏰ Saat: {{ $json.hour }}:00\n🔧 Backend: {{ $json.status === 'ok' ? '✅ Çalışıyor' : '❌ Çöktü' }}\n\n{{ $json.status === 'ok' ? 'Her şey yolunda!' : '⚠️ Dikkat gerekli!' }}"
      },
      "id": "send-telegram",
      "name": "Telegram'a Gönder",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [910, 300],
      "disabled": true,
      "credentials": {
        "telegramApi": {
          "id": "YOUR_TELEGRAM_CREDENTIAL_ID",
          "name": "Telegram"
        }
      }
    }
  ],
  "connections": {
    "Her Saat": {
      "main": [
        [
          {
            "node": "Backend Kontrol",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Backend Kontrol": {
      "main": [
        [
          {
            "node": "Veri Hazırla",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Veri Hazırla": {
      "main": [
        [
          {
            "node": "Telegram'a Gönder",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "fixora"
    },
    {
      "name": "analytics"
    }
  ]
}